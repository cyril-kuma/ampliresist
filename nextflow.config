/*
 * nano-rave-drag1 — ONT amplicon drug-resistance genotyping
 * Adapted from sanger-pathogens/nano-rave (C) 2022,2023 Genome Research Ltd.
 */

plugins {
    id 'nf-schema@2.1.1'
}

params {
    // --- Input -------------------------------------------------------------
    input              = null                                                           // run samplesheet CSV: run_name,sequencing_dir,sequencing_summary
    reference_manifest = "${projectDir}/assets/references/manifests/reference_manifest.csv"
    outdir             = "results"

    // --- Containers --------------------------------------------------------
    // Registry namespace for the two ampliresist-OWNED images (ampliresist-r,
    // ampliresist-figures; built from containers/*.Dockerfile). Replace 'owner'
    // with your GitHub org/user, or override at runtime: --container_registry.
    // Every other process pins a public tool image by immutable digest in-module.
    container_registry = 'ghcr.io/owner'

    // --- Read handling -----------------------------------------------------
    min_barcode_dir_size = 10    // MB; barcode dirs smaller than this are skipped

    // --- Variant calling ---------------------------------------------------
    variant_caller = 'clair3'    // clair3 | medaka | medaka_haploid | freebayes
    clair3_model   = "${projectDir}/assets/references/clair3_models/r1041_e82_400bps_sup_v430"
    clair3_args    = '--no_phasing_for_fa --include_all_ctgs --haploid_precise'

    // --- Drug-resistance analysis ------------------------------------------
    // The analysis pools EVERY flowcell in --input into one cohort: allele
    // frequencies are a property of the sample set, not of a flowcell.
    drug_resistance = true
    cohort_name     = 'DRAG1_cohort'   // label used in the analysis output filenames
    samplesheet     = null   // REQUIRED for --drug_resistance: user workbook (.xlsx, sheet 'samplesheet'). Pass --samplesheet; -profile test supplies a bundled one.
    // OPTIONAL override only. By default the cleaned ecological metadata is
    // DERIVED from --samplesheet inside the workflow (module 18a CLEAN_METADATA)
    // and propagated to stage 18 by channel — never a separately maintained file.
    plot_metadata   = null
    plot_geo_dir    = "${projectDir}/assets/geo"                // vendored Ghana boundaries (geoBoundaries, CC BY 4.0, CRS84)
    resources       = "${projectDir}/assets/resources"          // marker tables, genetic code, k13 WHO catalogue
    multiplex_sheet = 'samplesheet'
    // PRIMARY = 50x. Girgis 2023 (>50x) and Runtuwene 2018 (R >= 50 reads) converge
    // on this independently; nothing in the curated literature supports 10x. Use
    // `-profile sensitivity_10x` for the secondary analysis, and require every
    // qualitative conclusion to be threshold-invariant.
    min_cov         = 50         // amplicon median coverage AND per-SNP depth threshold
    analysis_date   = new java.util.Date().format('yyyyMMdd')

    // --- Misc --------------------------------------------------------------
    publish_dir_mode = 'copy'
    validate_params  = true
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        singularity.enabled = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
    test {
        includeConfig 'conf/test.config'
    }
    // Secondary depth threshold. 50x is primary (Girgis/Runtuwene); 10x recovers
    // low-density specimens (notably dhfr) at the cost of confidence. Any
    // conclusion that holds only at 10x is not a conclusion.
    sensitivity_10x {
        params.min_cov = 10
    }
    // Retained from upstream nano-rave for Sanger HPC.
    sanger_local {
        docker.enabled         = false
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = "${System.getenv('PWD')}"
        singularity.runOptions = "--bind /lustre,/nfs,/software,/data"
    }
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";     overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html";      overwrite = true }

manifest {
    name            = 'nano-rave-drag1'
    author          = 'WACCBIP / adapted from sanger-pathogens/nano-rave'
    description     = 'ONT amplicon variant calling and P. falciparum drug-resistance genotyping'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '2.3.0'
}
