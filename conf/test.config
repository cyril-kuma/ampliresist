/*
 * Smoke test:  nextflow run . -profile test,docker
 *
 * Self-contained: runs on the bundled dataset in assets/test_data/ (2 flowcells ×
 * 2 barcodes, subsampled reads and a truncated sequencing summary), so the
 * pipeline can be verified on a machine that has none of the study data.
 *
 * Exercises the whole thing end to end — channels, joins, containers, Clair3, all
 * four resistance stages and the CSP population-genetics subworkflow — and
 * because it spans TWO runs it also exercises the pooled-cohort path and the
 * (run, barcode) sample join, which is where a single-run test would miss bugs.
 *
 * It proves the wiring, not the accuracy of the variant calls.
 */

params {
    input  = "${projectDir}/assets/test_runs.csv"
    outdir = "results_test"

    // The bundled barcodes are subsampled to ~3 MB, well under the 10 MB default.
    min_barcode_dir_size = 1

    cohort_name = 'test_cohort'

    drug_resistance     = true
    min_cov             = 10
}

process {
    resourceLimits = [ cpus: 8, memory: 16.GB, time: 2.h ]
}
