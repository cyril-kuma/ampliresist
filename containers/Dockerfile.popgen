# Container for the CSP population-genetics subworkflow.
#
# The analysis chains command-line tools (bcftools / vcftools / plink / tabix)
# with R (pegas, adegenet, vcfR + rmarkdown for the report), so they live in one
# image rather than five: the scripts pipe between them within a single step.
#
# Build:
#   docker build -t drag1-popgen:1.0 -f containers/Dockerfile.popgen containers/
FROM rocker/tidyverse:4.4.1

RUN apt-get update && apt-get install -y --no-install-recommends \
        bcftools \
        vcftools \
        tabix \
        plink1.9 \
        libcurl4-openssl-dev libssl-dev libxml2-dev zlib1g-dev \
        libgdal-dev libgeos-dev libproj-dev libudunits2-dev && \
    rm -rf /var/lib/apt/lists/*

# The analysis scripts invoke `plink`; Debian ships the binary as `plink1.9`.
RUN ln -sf /usr/bin/plink1.9 /usr/local/bin/plink

# pegas / adegenet: haplotype networks, diversity, population structure.
# vcfR: VCF parsing. rmarkdown + knitr: the report.
RUN install2.r --error --skipinstalled --ncpus -1 \
        pegas \
        adegenet \
        vcfR \
        rmarkdown \
        knitr

# Fail the build rather than the pipeline if anything is missing.
RUN bcftools --version | head -n1 && \
    vcftools --version 2>&1 | head -n1 && \
    plink --version | head -n1 && \
    tabix --version | head -n1 && \
    Rscript -e 'pkgs <- c("pegas","adegenet","vcfR","rmarkdown","knitr","readxl","dplyr","ggplot2","tidyr","readr"); \
        missing <- pkgs[!pkgs %in% rownames(installed.packages())]; \
        if (length(missing)) stop("MISSING: ", paste(missing, collapse=", ")); \
        cat("All population-genetics R packages present\n")'

WORKDIR /analysis
