/*
 * Resource labels. Sized for a 16-core / 62 GB workstation; override per-site
 * with `-c <your.config>` or a custom profile.
 *
 * Retries on the usual transient/OOM exit codes, scaling memory with the attempt
 * so a single unlucky task doesn't force the whole run to be re-sized.
 */

process {
    cpus   = { 1 * task.attempt }
    memory = { 2.GB * task.attempt }
    time   = { 4.h * task.attempt }

    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    withLabel: process_single {
        cpus   = 1
        memory = { 2.GB * task.attempt }
    }
    withLabel: process_low {
        cpus   = 2
        memory = { 4.GB * task.attempt }
    }
    withLabel: process_medium {
        cpus   = 4
        memory = { 8.GB * task.attempt }
    }
    withLabel: process_high {
        cpus   = 8
        memory = { 16.GB * task.attempt }
    }
    withLabel: process_high_memory {
        memory = { 16.GB * task.attempt }
    }
}
