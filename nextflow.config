/*
 * nano-rave-drag1 — ONT amplicon drug-resistance genotyping
 * Adapted from sanger-pathogens/nano-rave (C) 2022,2023 Genome Research Ltd.
 */

plugins {
    id 'nf-schema@2.1.1'
}

params {
    // --- Input -------------------------------------------------------------
    input              = null                                                           // run samplesheet CSV: run_name,sequencing_dir,sequencing_summary
    reference_manifest = "${projectDir}/assets/references/manifests/reference_manifest.csv"
    outdir             = "results"

    // --- Read handling -----------------------------------------------------
    min_barcode_dir_size = 10    // MB; barcode dirs smaller than this are skipped

    // --- Variant calling ---------------------------------------------------
    variant_caller = 'clair3'    // clair3 | medaka | medaka_haploid | freebayes
    clair3_model   = "${projectDir}/assets/references/clair3_models/r1041_e82_400bps_sup_v430"
    clair3_args    = '--no_phasing_for_fa --include_all_ctgs --haploid_precise'

    // --- Drug-resistance analysis ------------------------------------------
    // The analysis pools EVERY flowcell in --input into one cohort: allele
    // frequencies are a property of the sample set, not of a flowcell.
    drug_resistance = true
    cohort_name     = 'DRAG1_cohort'   // label used in the analysis output filenames
    samplesheet     = "${projectDir}/assets/samplesheet.xlsx"   // sample metadata workbook
    resources       = "${projectDir}/assets/resources"          // marker tables, genetic code, k13 WHO catalogue
    multiplex_sheet = 'samplesheet'
    min_cov         = 10         // amplicon median coverage AND per-SNP depth threshold
    analysis_date   = new java.util.Date().format('yyyyMMdd')

    // --- CSP population genetics -------------------------------------------
    // A different question from drug resistance: csp is the RTS,S/R21 vaccine
    // target, so this describes parasite population structure and diversity.
    population_genetics    = true
    csp_contig_rename_map  = "${projectDir}/assets/resources/csp_contig_rename_map.tsv"
    // Ecological-zone grouping used for MAF / Fst / PCA. Values are matched
    // against the sample sheet's collection_region column.
    csp_coastal_regions    = 'Greater Accra'
    csp_middlebelt_regions = 'Bono|Ashanti'
    csp_savannah_regions   = 'Savannah|North East|Upper West'

    // --- Development escape hatch -------------------------------------------
    // The pipeline refuses to pool the same flowcell twice, because that
    // pseudoreplicates every sample it carries. Set this to true ONLY when a
    // flowcell is deliberately duplicated to develop the multi-batch path; the
    // results are then structurally valid but scientifically meaningless.
    allow_duplicate_runs = false

    // --- Misc --------------------------------------------------------------
    publish_dir_mode = 'copy'
    validate_params  = true
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        singularity.enabled = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
    test {
        includeConfig 'conf/test.config'
    }
    // Development only: allows the SAME flowcell to be pooled more than once.
    //
    // That is how the multi-batch path gets exercised before real second and
    // third batches exist -- but every sample in a repeated flowcell is then
    // counted once per copy, so the cohort allele frequencies and population
    // structure are pseudoreplicated and NOT scientifically usable.
    //
    //   nextflow run . -profile docker,dev --input assets/runs.csv ...
    dev {
        params.allow_duplicate_runs = true
    }
    // Retained from upstream nano-rave for Sanger HPC.
    sanger_local {
        docker.enabled         = false
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = "${System.getenv('PWD')}"
        singularity.runOptions = "--bind /lustre,/nfs,/software,/data"
    }
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";     overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html";      overwrite = true }

manifest {
    name            = 'nano-rave-drag1'
    author          = 'WACCBIP / adapted from sanger-pathogens/nano-rave'
    description     = 'ONT amplicon variant calling and P. falciparum drug-resistance genotyping'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '2.1.0'
}
