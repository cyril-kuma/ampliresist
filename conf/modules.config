/*
 * Per-process publishing and tool arguments.
 *
 * Keeping publishDir and ext.args here (rather than hard-coded inside each
 * process) means the results layout and the tool flags can change without
 * touching pipeline code, and a process's cache key only moves when its
 * arguments actually change.
 *
 * Results layout, numbered in execution order:
 *   01_qc/          nanoplot/<run>/  pycoqc/
 *   02_coverage/    <run>/*.bedGraph
 *   03_variants/    <run>/vcf/  <run>/vcf_unzipped/
 *   04_resistance/  <run>/01_coverage_qc .. 04_summary
 *   pipeline_info/  timeline, report, trace, DAG, software_versions.yml
 */

process {

    publishDir = [ enabled: false ]

    withName: NANOPLOT {
        publishDir = [
            path: { "${params.outdir}/01_qc/nanoplot/${meta.run_name}" },
            mode: params.publish_dir_mode,
            saveAs: { fn -> fn.equals('versions.yml') ? null : fn }
        ]
    }

    withName: PYCOQC {
        publishDir = [
            path: { "${params.outdir}/01_qc/pycoqc" },
            mode: params.publish_dir_mode,
            saveAs: { fn -> fn.equals('versions.yml') ? null : fn }
        ]
    }

    withName: BEDTOOLS_GENOMECOV {
        publishDir = [
            path: { "${params.outdir}/02_coverage/${meta.run_name}" },
            mode: params.publish_dir_mode,
            pattern: "*.bedGraph"
        ]
    }

    withName: BGZIP_TABIX {
        publishDir = [
            path: { "${params.outdir}/03_variants/${meta.run_name}/vcf" },
            mode: params.publish_dir_mode,
            pattern: "*.vcf.gz*"
        ]
    }

    withName: GUNZIP_VCF {
        publishDir = [
            path: { "${params.outdir}/03_variants/${run_name}/vcf_unzipped" },
            mode: params.publish_dir_mode,
            pattern: "*.vcf"
        ]
    }

    // The four drug-resistance stages each emit one numbered block. They run once
    // over the pooled cohort, so there is no per-run subdirectory here (unlike
    // 01_qc / 02_coverage / 03_variants, which stay per flowcell).
    withName: 'AMPLICON_COVERAGE|GENOTYPE_CALLS|RESISTANCE_FREQUENCIES|SUMMARY_TABLES' {
        publishDir = [
            path: { "${params.outdir}/04_resistance" },
            mode: params.publish_dir_mode
        ]
    }

    withName: PER_CALL_TABLE {
        publishDir = [
            path: { "${params.outdir}/03_variants/${run_name}" },
            mode: params.publish_dir_mode
        ]
    }


    withName: VERIFY_RUNS_DISTINCT {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode
        ]
    }

    withName: DUMP_VERSIONS {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode
        ]
    }

    // --- tool arguments ----------------------------------------------------

    withName: MINIMAP2_ALIGN {
        // --MD is required downstream: Clair3 reads MD tags.
        ext.args  = '-ax map-ont --MD'
        ext.args2 = ''            // samtools sort
    }

    withName: CLAIR3 {
        // --no_phasing_for_fa / --include_all_ctgs: Clair3's phasing and contig
        // filters assume human chromosomes and silently drop genotypes on small
        // Pf amplicons. --haploid_precise: P. falciparum is haploid.
        ext.args = params.clair3_args
    }
}
